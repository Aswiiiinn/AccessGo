DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_SETTINGS_MODULE=config.settings.development
ALLOWED_HOSTS=localhost,127.0.0.1
AI_API_KEY=your-ai-api-key-here
AI_API_URL=https://api.example.com/v1/chat/completions
GEMINI_API_KEY=gemini_api_key_here
GEMINI_MODEL=gemini_model_here

# Frontend origin used to build password reset links (/reset-password?uid=...&token=...)
FRONTEND_BASE_URL=http://localhost:5173
# Reset link lifetime in seconds (default 1 hour)
PASSWORD_RESET_TIMEOUT=3600

# Email delivery. In development the console backend is the default and prints
# emails to the runserver terminal. For real delivery use the SMTP backend:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=AccessGo <noreply@accessgo.local>

# Rate limits for password endpoints (DRF format: N/second|minute|hour|day)
THROTTLE_PASSWORD_RESET=5/hour
THROTTLE_PASSWORD_RESET_CONFIRM=20/hour
THROTTLE_PASSWORD_CHANGE=10/hour
